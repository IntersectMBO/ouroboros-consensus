-- Custom repository for cardano haskell packages, see CONTRIBUTING for more
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- See CONTRIBUTING for some Nix commands you will need to run if you
-- update either of these.
index-state:
  -- Bump this if you need newer packages from Hackage
  , hackage.haskell.org 2026-09-07T04:49:09Z
  -- Bump this if you need newer packages from CHaP
  , cardano-haskell-packages 2026-09-04T09:27:20Z

active-repositories:
  , :rest
  , cardano-haskell-packages:override

packages: .

-- TEMPORARY: the kes-agent fork pinned below (PR #105) still caps
-- cardano-crypto-class at ^>=2.5 (i.e. <2.6), predating its own
-- FixedSizeCodec migration that (per that SRP's comment) already made it
-- compatible with cardano-crypto-class-2.6.0.0. Relaxing the bound against
-- its already-fetched code is safe. Remove alongside that SRP once
-- upstream catches up.
allow-newer:
  kes-agent:cardano-crypto-class,
  kes-agent-crypto:cardano-crypto-class,
  ouroboros-consensus:cardano-ledger-shelley,
  ouroboros-consensus:cardano-ledger-alonzo,
  ouroboros-consensus:cardano-ledger-babbage,
  ouroboros-consensus:cardano-ledger-conway,
  ouroboros-consensus:small-steps,
  ouroboros-consensus:cardano-crypto-class,

-- TEMPORARY: cardano-ledger PR #5992 merged into master as
-- dae069780697449fbd9cda47f03fb72745b0b8c0. Pinned to master's tip (not
-- yet in a CHaP release) -- remove once a release picks it up.
-- Includes eras/byron/ledger/executable-spec (byron-spec-ledger) and
-- eras/byron/chain/executable-spec (byron-spec-chain) because CHaP's
-- released versions predate small-steps-1.2.0.0's new `Ord
-- (PredicateFailure a)` superclass on STS; master's versions of both (not
-- yet released either) derive Ord on their PredicateFailure types.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-ledger.git
  tag: dae069780697449fbd9cda47f03fb72745b0b8c0
  subdir:
    libs/cardano-ledger-core
    libs/cardano-ledger-api
    libs/cardano-ledger-binary
    libs/cardano-protocol
    libs/cardano-protocol-tpraos
    libs/cardano-data
    libs/small-steps
    libs/vector-map
    libs/non-integral
    eras/byron/ledger/executable-spec
    eras/byron/chain/executable-spec
    eras/shelley/impl
    eras/shelley/test-suite
    eras/mary/impl
    eras/allegra/impl
    eras/alonzo/impl
    eras/babbage/impl
    eras/conway/impl
    eras/dijkstra/impl

-- TEMPORARY: cardano-ledger-binary (see the SRP above) now needs
-- cardano-crypto-leios >=0.3, but the highest release on CHaP is 0.2.0.0
-- and 0.3.0.0 isn't tagged upstream yet -- it only exists on cardano-base's
-- master. Remove once a 0.3.0.0 release lands on CHaP.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-base
  tag: d92e2e3841eaad354c5e1ef77b458b347f471271
  subdir: cardano-crypto-leios

-- TEMPORARY: cardano-ledger-binary (see the SRP above) now needs
-- cuddle >=1.8, but CHaP's `active-repositories:override` masks Hackage's
-- newer releases behind its own cap of 1.2.0.0 for any package CHaP also
-- carries. A direct git SRP isn't subject to that override, so pin cuddle
-- here to bypass it. Remove once CHaP's cuddle catches up (or the
-- override is dropped).
source-repository-package
  type: git
  location: https://github.com/input-output-hk/cuddle
  tag: 416f7aeaa510d4be5ea8f1d26d4cdd5501629058

-- We want to always build the test-suites and benchmarks
tests: true
benchmarks: true

multi-repl: True

import: cabal/asserts.cabal
import: cabal/newer-ghcs.cabal

package ouroboros-network
  -- Certain ThreadNet tests rely on transactions to be submitted promptly after
  -- a node (re)start. Therefore, we disable this flag (see
  -- https://github.com/IntersectMBO/ouroboros-network/issues/4927 for context).
  flags: -txsubmission-delay

-- We need to disable bitvec's SIMD for now, as it breaks during cross compilation.
if os (windows)
  constraints:
    bitvec -simd

constraints:
  tasty <1.5.4,

-- TEMPORARY: cardano-ledger PR #5999 (erikd/ram) merged into master as
-- dae069780697449fbd9cda47f03fb72745b0b8c0, which switches
-- cardano-crypto-wrapper from `memory` to `ram` (crypton >=1.1's
-- replacement for `memory`), so it builds against crypton >=1.1. This is
-- the only package in the chain that needs an actual source change; the
-- allow-newer entries above cover everything else, which just has an
-- overly conservative cardano-crypto-class upper bound. Pinned to
-- master's tip (not yet in a CHaP release) -- remove once a release
-- picks it up.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-ledger
  tag: dae069780697449fbd9cda47f03fb72745b0b8c0
  subdir: eras/byron/crypto
