-- See CONTRIBUTING for some Nix commands you will need to run if you
-- update either of these.
index-state:
  , hackage.haskell.org 2026-09-02T14:05:07Z
  , cardano-haskell-packages 2026-09-02T08:49:12Z

-- TODO: needed to drop because newer cuddle on hackage would have not been seen
-- active-repositories:
--   , :rest
--   , cardano-haskell-packages:override

packages: .

-- We want to always build the test-suites and benchmarks
tests: true
benchmarks: true

multi-repl: True

import: cabal/asserts.cabal
import: cabal/newer-ghcs.cabal

package ouroboros-network
  -- Certain ThreadNet tests rely on transactions to be submitted promptly after
  -- a node (re)start. Therefore, we disable this flag (see
  -- https://github.com/IntersectMBO/ouroboros-network/issues/4927 for context).
  flags: -txsubmission-delay

-- We need to disable bitvec's SIMD for now, as it breaks during cross compilation.
if os (windows)
  constraints:
    bitvec -simd

-- TODO: bump packages instead of this
allow-newer:
  , cardano-crypto-class
-- Hold the crypto closure on the old `memory` line rather than following crypton
-- onto `ram`, which cascades through cardano-crypto/crypton-x509/tls/grapesy for no
-- code benefit. The crypton pin only works together with the matching declaration
-- swap in the sibling cardano-crypto-class (see cabal.project.local): pinning one
-- without the other puts both ByteArray classes in scope.
allow-older:
  , cardano-crypto-class:crypton
constraints:
  , any.crypton < 1.1

-- Points to ouroboros-network/leios-prototype
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/ouroboros-network
  tag: 4b3ab7664f609a1aee0f0c24dcfcfd0ab899fc42
  --sha256: sha256-fIqpI2whstetodpiONmUDVgnhTpzXeq1/gmzuHItK5A=
  subdir:
    ouroboros-network
    cardano-diffusion
    network-mux

