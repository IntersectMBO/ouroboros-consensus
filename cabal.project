-- Custom repository for cardano haskell packages, see CONTRIBUTING for more
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- See CONTRIBUTING for some Nix commands you will need to run if you
-- update either of these.
index-state:
  -- Bump this if you need newer packages from Hackage
  -- Bump this if you need newer packages from CHaP
  , hackage.haskell.org 2026-09-02T14:05:07Z
  , cardano-haskell-packages 2026-10-06T16:46:26Z

packages: .
-- We want to always build the test-suites and benchmarks
tests: True
benchmarks: True
multi-repl: True
import: cabal/asserts.cabal
import: cabal/newer-ghcs.cabal

package ouroboros-network
  -- Certain ThreadNet tests rely on transactions to be submitted promptly after
  -- a node (re)start. Therefore, we disable this flag (see
  -- https://github.com/IntersectMBO/ouroboros-network/issues/4927 for context).
  flags: -txsubmission-delay

-- We need to disable bitvec's SIMD for now, as it breaks during cross compilation.
if os(windows)
  constraints:
    bitvec -simd
constraints:
  tasty <1.5.4,

-- Temporary source prerequisites for the CIP-160 ledger draft PR 6153.
-- Remove these overrides after the reviewed package versions reach CHaP.
source-repository-package
  type: git
  location: https://github.com/colll78/cardano-ledger.git
  tag: 03b9b682157b96eecc3e5c057599b18d0b376b65
  --sha256: sha256-B1sHHR2Lmm4C6WUhuBA7cM6HlpJxOt3k8ItVUCkwvEA=
  subdir:
    eras/allegra/impl
    eras/alonzo/impl
    eras/babbage/impl
    eras/byron/crypto
    eras/byron/ledger/impl
    eras/conway/impl
    eras/dijkstra/impl
    eras/mary/impl
    eras/shelley/impl
    libs/cardano-data
    libs/cardano-ledger-api
    libs/cardano-ledger-binary
    libs/cardano-ledger-core
    libs/cardano-protocol
    libs/cardano-protocol-tpraos
    libs/non-integral
    libs/small-steps
    libs/vector-map

source-repository-package
  type: git
  location: https://github.com/colll78/plutus.git
  tag: dcbb7e3232c3322557410fe341ec84f3cd78dc04
  --sha256: sha256-6n+edByIhXRu9+ZfeMhIKLlfkcj/7aRJ1mrH29mn4nE=
  subdir: plutus-ledger-api

source-repository-package
  type: git
  location: https://github.com/colll78/cardano-keys.git
  tag: b63987bd43d99b82b91d29020ceab089fb61b123
  --sha256: sha256-7oRxoZjCv/RhnnRWQ8LvI4sknlEGqy81j8uFxuJzOc0=
  subdir: cardano-keys

source-repository-package
  type: git
  location: https://github.com/colll78/cardano-config.git
  tag: e7a6f979964d2f613671832af001d06f99a67a86
  --sha256: sha256-D+PbL2GcvEwCpazxy8cYncl8EUjwuR4H5Wj2HWO3UX0=

-- Dependency test suites run in their owning repositories; preserve this
-- repository's complete set of owning tests and benchmarks.
package *
  tests: False
  benchmarks: False

package ouroboros-consensus
  tests: True
  benchmarks: True
