-- Pinned to 3d5e2ba1 rather than cardano-base's current master tip: the very
-- next commit (58f5a53a) refactors cardano-crypto-class's BLS12-381 DSIGN
-- API (ContextDSIGN (BLS12381DSIGN curve) changes from BLS12381SignContext
-- to (), and verifyPossessionProofDSIGN/verifyDSIGN drop an argument
-- accordingly), which cardano-crypto-leios's own source (pulled in via this
-- same SRP) is written against once bumped past that point -- but CHaP's
-- published cardano-crypto-class-2.6.0.0 (what this project actually
-- resolves cardano-crypto-class from) still has the pre-refactor shape, so
-- anything past 3d5e2ba1 fails to typecheck. 3d5e2ba1 is the newest commit
-- that still matches CHaP's API. Matches cardano-node's own pin for the same
-- reason -- keep them in sync rather than drifting independently.
source-repository-package
  type: git
  location: https://github.com/intersectmbo/cardano-base.git
  --sha256: sha256-Wr6CZW4OR4nsbARIbLKIf61jQfO1WsiT9HPLV+mfZYU=
  tag: 3d5e2ba1e76b7cd3bead8bd3f81a2e7ee743ce5c
  subdir: cardano-crypto-leios

packages: .


-- Temp: pin ouroboros-network to main, where NodeToClientV_23 is the only
-- NodeToClient version. Drop once these packages are released to CHaP.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/ouroboros-network.git
  tag: a3d8017e798b225055aaf9118ad062fe58bc650f
  --sha256: sha256-nrDi43HfvKAg+5wE6PF4QI4HmYh1rav3a5uqw24BFv0=
  subdir:
    ouroboros-network
    cardano-diffusion
    network-mux

-- We want to always build the test-suites and benchmarks
tests: true
benchmarks: true

multi-repl: True

import: cabal/asserts.cabal
import: cabal/newer-ghcs.cabal

package ouroboros-network
  -- Certain ThreadNet tests rely on transactions to be submitted promptly after
  -- a node (re)start. Therefore, we disable this flag (see
  -- https://github.com/IntersectMBO/ouroboros-network/issues/4927 for context).
  flags: -txsubmission-delay

-- We need to disable bitvec's SIMD for now, as it breaks during cross compilation.
if os (windows)
  constraints:
    bitvec -simd

constraints:
  tasty <1.5.4,
