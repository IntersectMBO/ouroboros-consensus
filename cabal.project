  location: https://github.com/koslambrou/kes-agent
  tag: 4625f3cf543566517d08882e659c97932d106d86
  --sha256: sha256-CSHWndpeJFqCEFNT6ysfyN6x+O4vZ9TtYOOsZKcLnIA=
  subdir:
    kes-agent
    kes-agent-crypto

source-repository-package
