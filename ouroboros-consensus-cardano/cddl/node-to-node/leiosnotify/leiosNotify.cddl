; The messages of the LeiosNotify mini-protocol, as the cardano-blueprint's
; network/node-to-node/leios-notify/messages.cddl has them, except that
;
; - an announcement is any CBOR, where the blueprint has a Cardano header,
;   since the test that checks this file does not fix the header type, and
;
; - a MsgLeiosVotes holds at most sixteen votes, which the blueprint does not
;   bound.
;
; TODO Bound the votes in the blueprint too, and check the Cardano block's
; codec against the blueprint's file itself; then drop this file.

leiosNotifyMessage
  = msgDone
  / msgQuit
  / msgCanceled
  / msgLeiosNotificationRequestNext
  / msgLeiosBlockAnnouncement
  / msgLeiosBlockOffer
  / msgLeiosBlockTxsOffer
  / msgLeiosVotes

msgDone                         = [0]
msgQuit                         = [1]
msgCanceled                     = [2]
msgLeiosNotificationRequestNext = [3]
msgLeiosBlockAnnouncement       = [4, announcement]
msgLeiosBlockOffer              = [5, point, eb_size]
msgLeiosBlockTxsOffer           = [6, point]
msgLeiosVotes                   = [7, [1*16 vote]]

; the announcing ranking block's header, as ChainSync sends it
announcement = any

point = [slot, eb_hash]
slot = uint .size 8
eb_hash = bytes .size 32
eb_size = uint .size 4

vote =
  [ announcing_rb_hash : bytes .size 32
  , voter_id           : uint .size 2
  , vote_signature     : bytes .size 48
  ]
