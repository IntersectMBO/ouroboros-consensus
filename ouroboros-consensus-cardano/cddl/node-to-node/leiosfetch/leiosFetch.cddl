; The messages of the LeiosFetch mini-protocol
;
; TODO Upstream this from ouroboroso-consensus into cardano-blueprint and not
; only sync it using a GHA workflow

leiosFetchMessage
  = msgDone
  / msgLeiosBlockRequest
  / msgLeiosBlock
  / msgLeiosBlockTxsRequest
  / msgLeiosBlockTxs

msgDone                 = [0]
msgLeiosBlockRequest    = [1, point]
msgLeiosBlock           = [2, endorser_block]
msgLeiosBlockTxsRequest = [3, point, bitmaps]
msgLeiosBlockTxs        = [4, tx_list]

point = [base.slotno, eb_hash]
eb_hash = base.hash

; The endorser block as CBOR-in-CBOR to indicate what bytes are hashed and that
; servers may serve them without decoding. Was introduced with Dijkstra era and
; currently only one format exists. When the structure changes, fetch clients
; and other consensus components will know which era this is from; endorser
; blocks are not allowed to be used across era boundaries.
endorser_block = #6.24(bytes .cbor dijkstra.eb_references)

; Inspired by roaring bitmaps: 64-tx window index to 64-bit presence bitmaps
bitmaps = { * uint .size 2 => uint .size 8 }

tx_list = [ *tx.tx ]

; Endorsed transactions as CBOR-in-CBOR to indicate that neither fetch clients
; nor servers will decode this. However, consensus components like leios voting
; logic or block adoption will need to decode these using the approriate era.
; Currently only dikjstra is supported.
tx = #6.24(bytes .cbor dijkstra.block_transaction)

;# include dijkstra as dijkstra
;# import base as base
