; The messages of the LeiosFetch mini-protocol, as the cardano-blueprint's
; network/node-to-node/leios-fetch/messages.cddl has them, except that
;
; - a MsgLeiosBlockTxs carries only the transactions, where the blueprint's
;   also repeats the request's point and bitmaps,
;
; - a transaction is not tagged with its era, where the blueprint's is, as
;   transaction submission tags it, and
;
; - an endorser block names at least one transaction, which the blueprint does
;   not require.
;
; TODO Make the blueprint agree on all three; then drop this file in favour of
; the blueprint's.

leiosFetchMessage
  = msgDone
  / msgLeiosBlockRequest
  / msgLeiosBlock
  / msgLeiosBlockTxsRequest
  / msgLeiosBlockTxs

msgDone                 = [0]
msgLeiosBlockRequest    = [1, point]
msgLeiosBlock           = [2, endorser_block]
msgLeiosBlockTxsRequest = [3, point, bitmaps]
msgLeiosBlockTxs        = [4, [* tx]]

point = [slot, eb_hash]
slot = uint .size 8
eb_hash = bytes .size 32

; the hash and size of each transaction the endorser block names
endorser_block = { + tx_hash => tx_size }
tx_hash = bytes .size 32
tx_size = uint .size 4

; from the index of each run of 64 transactions to the bitmap of those 64
bitmaps = { * uint .size 2 => uint .size 8 }

tx = #6.24(bytes .cbor any)   ; the any is the block_transaction of whichever era this EB was announced in
                              ; eg, tx = #6.24(bytes .cbor dijkstra.block_transaction)
