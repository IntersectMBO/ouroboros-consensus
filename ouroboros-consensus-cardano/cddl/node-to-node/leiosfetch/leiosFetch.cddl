; The messages of the LeiosFetch mini-protocol
;
; TODO Upstream this from ouroboros-consensus into cardano-blueprint and not
; only sync it using a GHA workflow

leiosFetchMessage
  = msgDone
  / msgLeiosBlockRequest
  / msgLeiosBlock
  / msgLeiosBlockTxsRequest
  / msgLeiosBlockTxs

msgDone                 = [0]
msgLeiosBlockRequest    = [1, point]
msgLeiosBlock           = [2, endorser_block]

msgLeiosBlockTxsRequest = [3, point, txs_bitmap] ; 'txs_bitmap' MUST name only the (more than zero) offsets its endorser block (`point`) has.
msgLeiosBlockTxs        = [4, txs] ; 'txs' MUST include all transactions requested with 'msgLeiosBlockTxsRequest' in exactly the requested order.

point = [base.slotno, eb_hash]
eb_hash = base.hash

; The endorser block as CBOR-in-CBOR to indicate what bytes are hashed and that
; servers may serve them without decoding. Was introduced with Dijkstra era and
; currently only one format exists. When the structure changes, fetch clients
; and other consensus components will know which era this is from; endorser
; blocks are not allowed to be used across era boundaries.
endorser_block = #6.24(bytes .cbor dijkstra.eb_references)

; Chunked sparse bitmap: Chunk index to that chunk's presence bitmap, one
; bit per tx, the most significant bit naming the chunk's first tx.
;
; Bitmap's total width is 17142 bits (maxTxsPerEndorserBlock) and chunk width is 64 bits.
; This means the last chunk (index 267) has a width of 54 bits + 2 zero padding bits (7 bytes).
; Eq. (267 chunks x 64 bits) + (1 chunk x 54 bits) = 17142 bits (txs)
;
; Chunk indices MUST be:
; 1. strictly ascending (so also without duplicates),
; 2. in range from [0,267] (first 0, last 267, inclusive).
;
; Chunk bitmaps MUST be:
; 1. non-zero (must name an index),
; 2. exactly 8 bytes (64 bit width) if its chunk index is less than 267,
; 3. exactly 7 bytes (54 bit width + 2 zero padding bits) if its chunk index is equal to 267 (last index).
;
; Examples:
; 1. First chunk naming first 3 transactions [0,2] = 0xe0_00_00_00_00_00_00_00 (0xe0 = 0b1110_0000)
; 2. Last chunk naming last 54 txs [17088,17141] = 0xff_ff_ff_ff_ff_ff_fc (0xfc = 0b1111_1100)
txs_bitmap = { + uint .size 2 => bytes .size (7..8) }

; The requested transactions, non-empty, since a 'txs_bitmap' names at least one
; tx.
;
; The number of entries MUST be less than or equal to 17142 (maxTxsPerEndorserBlock).
; Transaction MUST be listed in the order they were requested.
; All requested transactions MUST be listed.
txs = [ +tx ]

; Endorsed transactions as CBOR-in-CBOR to indicate that neither fetch clients
; nor servers will decode this. However, consensus components like leios voting
; logic or block adoption will need to decode these using the appropriate era.
; Currently only Dijkstra is supported.
tx = #6.24(bytes .cbor dijkstra.block_transaction)

;# include dijkstra as dijkstra
