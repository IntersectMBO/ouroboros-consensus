; The messages of the LeiosFetch mini-protocol
;
; TODO Upstream this from ouroboros-consensus into cardano-blueprint and not
; only sync it using a GHA workflow

leiosFetchMessage
  = msgDone
  / msgLeiosBlockRequest
  / msgLeiosBlock
  / msgLeiosBlockTxsRequest
  / msgLeiosBlockTxs

msgDone                 = [0]
msgLeiosBlockRequest    = [1, point]
msgLeiosBlock           = [2, endorser_block]
msgLeiosBlockTxsRequest = [3, point, txs_bitmap]
msgLeiosBlockTxs        = [4, tx_list]

point = [base.slotno, eb_hash]
eb_hash = base.hash

; The endorser block as CBOR-in-CBOR to indicate what bytes are hashed and that
; servers may serve them without decoding. Was introduced with Dijkstra era and
; currently only one format exists. When the structure changes, fetch clients
; and other consensus components will know which era this is from; endorser
; blocks are not allowed to be used across era boundaries.
endorser_block = #6.24(bytes .cbor dijkstra.eb_references)

; Chunked sparse bitmap: 64-tx chunk index to that chunk's presence bitmap, one
; bit per tx, the most significant bit naming the chunk's first tx. Every chunk
; is exactly 8 bytes.
;
; The bitmap's total width is the protocol constant txsBitmapWidth, 32768 txs,
; so 512 chunks: neither negotiated nor a protocol parameter, and deliberately
; not derived from the node's design ceiling on an endorser block's tx count,
; so that raising the ceiling does not change this wire format; the constant
; only has to stay above whatever the ceiling allows (currently 17142 txs).
;
; Beyond this rule, a decoder requires the chunk indices to be strictly
; ascending (so also without duplicates) and below 512, and every chunk to be
; non-zero. A request may name only offsets its endorser block has; the server
; rejects any other as unknown.
txs_bitmap = { + uint .size 2 => bytes .size 8 }

; The requested transactions. Non-empty, since a txs_bitmap names at least one
; tx. Beyond this rule, the decoder rejects more entries than the node's design
; ceiling on an endorser block's tx count (currently 17142), and the
; client requires exactly as many txs as its request's
; txs_bitmap has bits set, in ascending offset order, each matching the
; endorser block's reference for its offset --- a reply that conforms to this
; rule but answers a different selection still costs the server the
; connection.
tx_list = [ +tx ]

; Endorsed transactions as CBOR-in-CBOR to indicate that neither fetch clients
; nor servers will decode this. However, consensus components like leios voting
; logic or block adoption will need to decode these using the appropriate era.
; Currently only Dijkstra is supported.
tx = #6.24(bytes .cbor dijkstra.block_transaction)

