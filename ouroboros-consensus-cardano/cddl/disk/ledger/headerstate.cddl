headerState =
  [withOrigin<headerStateTip>, headerStateChainDep]

headerStateTip =
  ns8<byronAnnTip, annTip, annTip, annTip, annTip, annTip, annTip, annTip>

byronAnnTip = [slotno,
               hash,
               blockno,
               bool]

annTip = [slotno,
          hash,
          blockno]

headerStateChainDep =
  telescope8<pbftState,
             tpraosState,
             tpraosState,
             tpraosState,
             tpraosState,
             praosState,
             praosState,
             praosState>

pbftState = {* keyhash => [* slotno]}

tpraosState = [withOrigin<slotno>, sl.chainDepState]

praosState = [withOrigin<slotno>,
              {* keyhash => word64},
              nonce,
              nonce,
              nonce,
              nonce,
              nonce,
              nonce]

;; These should belong to the Ledger
sl.chainDepState = [prtclState, ticknState, nonce]

prtclState = [{* keyhash => word64}, nonce, nonce]

ticknState = [nonce, nonce]

;# import withOrigin, ns8, telescope8, slotno, hash, blockno, keyhash, word64, nonce from base
