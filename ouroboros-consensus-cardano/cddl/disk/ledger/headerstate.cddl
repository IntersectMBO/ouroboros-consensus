headerState =
  [withOrigin<headerStateTip>, headerStateChainDep]

headerStateTip =
  ns8<byronAnnTip, annTip, annTip, annTip, annTip, annTip, annTip, annTip>

byronAnnTip = [slotno,
               hash,
               blockno,
               bool]

annTip = [slotno,
          hash,
          blockno]

headerStateChainDep =
  telescope8<pbftState,
             tpraosState,
             tpraosState,
             tpraosState,
             tpraosState,
             praosState,
             praosState,
             praos2State>

pbftState = {* keyhash => [* slotno]}

tpraosState = [withOrigin<slotno>, sl.chainDepState]

praosState = [withOrigin<slotno>,
              {* keyhash => word64},
              nonce,
              nonce,
              nonce,
              nonce,
              nonce,
              nonce]

; The Praos state, followed by what the next header may certify.
praos2State = [withOrigin<slotno>,
               {* keyhash => word64},
               nonce,
               nonce,
               nonce,
               nonce,
               nonce,
               nonce,
               certifiable]

; The announcement carried by the most recently applied header, or why the next
; header may certify none: 0 if nothing was announced, 1 if it was announced in
; the previous era, 3 if it was announced in the previous epoch.
certifiable = [0] / [1] / [2, announcedBy] / [3]

; The issuer, followed by the announced endorser block's hash and size.
announcedBy = [keyhash, hash, word32]

sl.chainDepState = [prtclState, ticknState, nonce]

prtclState = [{* keyhash => word64}, nonce, nonce]

ticknState = [nonce, nonce]

;# import withOrigin, ns8, telescope8, slotno, hash, blockno, keyhash, word32, word64, nonce from base
