headerState =
  [withOrigin<headerStateTip>, headerStateChainDep]

headerStateTip =
  ns8<byronAnnTip, annTip, annTip, annTip, annTip, annTip, annTip, annTip>

byronAnnTip = [slotno,
               hash,
               blockno,
               bool]

annTip = [slotno,
          hash,
          blockno]

headerStateChainDep =
  telescope8<pbftState,
             tpraosState,
             tpraosState,
             tpraosState,
             tpraosState,
             praosState,
             praosState,
             praos2State>

pbftState = {* keyhash => [* slotno]}

tpraosState = [withOrigin<slotno>, sl.chainDepState]

praosState = [withOrigin<slotno>,
              {* keyhash => word64},
              nonce,
              nonce,
              nonce,
              nonce,
              nonce,
              nonce]

; The Praos state, followed by the announcement carried by the most recently
; applied header, if any.
praos2State = [withOrigin<slotno>,
               {* keyhash => word64},
               nonce,
               nonce,
               nonce,
               nonce,
               nonce,
               nonce,
               maybe<announcedBy>]

; The issuer, followed by the announced endorser block's hash and size.
announcedBy = [keyhash, hash, word32]

sl.chainDepState = [prtclState, ticknState, nonce]

prtclState = [{* keyhash => word64}, nonce, nonce]

ticknState = [nonce, nonce]

;# import withOrigin, ns8, telescope8, slotno, hash, blockno, keyhash, word32, word64, nonce, maybe from base
